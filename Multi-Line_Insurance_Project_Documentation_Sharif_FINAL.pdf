BT 1 0 0 1 4 338.2 Tm /F4 7.4 Tf 9.6 TL (public class PremiumCalculator {) Tj T* (  public class PremiumInputWrapper {) Tj T* (    @InvocableVariable\(required=true\)) Tj T* (    public Id policyId;) Tj T* (  }) Tj T*  T* (  @InvocableMethod\(label='Calculate Policy Premium') Tj T* (      description='Calculates premium based on policy fields \(VIN, Model Year, State\).'\)) Tj T* (  public static List<Decimal> calculatePremium\(List<PremiumInputWrapper> inputs\) {) Tj T* (    List<Decimal> premiumResults = new List<Decimal>\(\);) Tj T* (    Set<Id> policyIds = new Set<Id>\(\);) Tj T* (    for \(PremiumInputWrapper input : inputs\) {) Tj T* (      if \(input.policyId != null\) {) Tj T* (        policyIds.add\(input.policyId\);) Tj T* (      }) Tj T* (    }) Tj T* (    List<Policy__c> policiesToRate = [) Tj T* (      SELECT Id, VIN__c, Model_Year__c, Policy_State__c) Tj T* (      FROM Policy__c) Tj T* (      WHERE Id IN :policyIds) Tj T* (    ];) Tj T* (    for \(Policy__c policy : policiesToRate\) {) Tj T* (      Decimal basePremium = 1000.00;) Tj T* (      if \(policy.Policy_State__c == 'CA'\) {) Tj T* (        basePremium *= 1.15;) Tj T* (      } else if \(policy.Policy_State__c == 'TX'\) {) Tj T* (        basePremium *= 1.05;) Tj T* (      }) Tj T* (      if \(policy.Model_Year__c != null && Integer.valueOf\(policy.Model_Year__c\) < 2018\) {) Tj T* (        basePremium += 100;) Tj T* (      }) Tj T* (      premiumResults.add\(basePremium\);) Tj T* (    }) Tj T* (    return premiumResults;) Tj T* (  }) Tj T* (}) Tj T* ET
Q
