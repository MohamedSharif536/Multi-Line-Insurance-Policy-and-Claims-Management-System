BT 1 0 0 1 4 251.8 Tm /F4 7.4 Tf 9.6 TL (public class ClaimsAdjusterController {) Tj T* (  public class ClaimWrapper {) Tj T* (    @AuraEnabled public Id claimId;) Tj T* (    @AuraEnabled public String claimNumber;) Tj T* (    @AuraEnabled public Decimal claimAmount;) Tj T* (    @AuraEnabled public String status;) Tj T* (    @AuraEnabled public String policyType;) Tj T* (    @AuraEnabled public String policyHolderName;) Tj T* (    @AuraEnabled public Integer daysOpen;) Tj T*  T* (    public ClaimWrapper\(Claim__c c, Policy__c p, Contact customerRec\) {) Tj T* (      this.claimId = c.Id;) Tj T* (      this.claimNumber = c.Name;) Tj T* (      this.claimAmount = c.Claim_Amount__c;) Tj T* (      this.status = c.Approval_Status__c;) Tj T* (      Policy__c policyRecord = \(Policy__c\)p;) Tj T* (      if \(policyRecord != null && policyRecord.RecordType != null\) {) Tj T* (        this.policyType = policyRecord.RecordType.Name;) Tj T* (      } else {) Tj T* (        this.policyType = 'Unknown';) Tj T* (      }) Tj T* (      this.policyHolderName = \(customerRec != null\) ? customerRec.Name : '';) Tj T* (      this.daysOpen = \(c.Date_of_Loss__c != null\)) Tj T* (          ? \(c.Date_of_Loss__c.date\(\).daysBetween\(Date.today\(\)\)\)) Tj T* (          : 0;) Tj T* (    }) Tj T* (  }) Tj T* ET
Q
